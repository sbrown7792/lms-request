# Copy to .env on the deployment host and edit.
# Used by docker-compose.deploy.yml.

# Your GitHub username or org, lowercase — the image lives at
# ghcr.io/<owner>/lms-request
GHCR_OWNER=your-github-username

# latest (newest release), edge (newest main build), or a version like 0.1.0
IMAGE_TAG=latest

# Where LMS is, as resolved from *inside* the container
LMS_HOST=lms
LMS_PORT=9000

# Port on the host. The container always listens on 8080 internally.
HOST_PORT=8080

# Host console password. Leave blank to have one generated and logged.
HOST_TOKEN=

# Set true only behind a reverse proxy you control.
TRUST_FORWARDED_FOR=false

# Only if the QR needs a different address than the one the TV browser used.
PUBLIC_URL=

# Safety guard. Comma-separated player ids (MACs) allowed to receive commands;
# empty means all players. Set it for a dry run before the party, so a test
# cannot start music in the wrong room.
ALLOWED_PLAYERS=
